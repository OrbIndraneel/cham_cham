{
  "expo": {
    "name": "SURAKSHA AI",
    "slug": "suraksha-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "suraksha-ai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.suraksha.ai",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SURAKSHA AI requires location permissions to display live disaster hazard proximity and calculate dynamic safe evacuation routes.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SURAKSHA AI requires background location permissions to alert you of incoming flash floods and evacuation orders in your immediate area."
      }
    },
    "android": {
      "package": "com.suraksha.ai",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCyKahAehSShdxhN1LOfObLMroOD2SVbYs"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#18181B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "INTERNET"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#18181B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SURAKSHA AI to use your location to calculate live safe evacuation paths away from flood & landslide zones."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#DC2626",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b6119536-5516-495c-adfe-e212a15c0a02"
      }
    }
  }
}
